{
  "lexicon": 1,
  "id": "fyi.atstore.directory.searchListings",
  "defs": {
    "listingCardSearch": {
      "type": "object",
      "required": [
        "uri",
        "name",
        "tagline",
        "description",
        "category",
        "accent",
        "reviewCount",
        "priceLabel",
        "appTags",
        "categorySlugs",
        "iconUrl",
        "heroImageUrl",
        "categorySlug",
        "rating",
        "productAccountHandle"
      ],
      "nullable": [
        "iconUrl",
        "heroImageUrl",
        "categorySlug",
        "rating",
        "productAccountHandle"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "format": "at-uri",
          "maxLength": 2560,
          "description": "AT URI of the fyi.atstore.listing.detail record."
        },
        "name": { "type": "string", "maxLength": 640 },
        "tagline": { "type": "string", "maxLength": 2000 },
        "description": { "type": "string", "maxLength": 20000 },
        "iconUrl": { "type": "string", "maxLength": 8192 },
        "heroImageUrl": {
          "type": "string",
          "maxLength": 8192
        },
        "categorySlug": {
          "type": "string",
          "maxLength": 512
        },
        "categorySlugs": {
          "type": "array",
          "items": { "type": "string", "maxLength": 512 }
        },
        "category": { "type": "string", "maxLength": 640 },
        "accent": {
          "type": "string",
          "maxLength": 16,
          "knownValues": ["blue", "pink", "purple", "green"]
        },
        "rating": {
          "type": "string",
          "maxLength": 16
        },
        "reviewCount": { "type": "integer" },
        "priceLabel": { "type": "string", "maxLength": 32 },
        "productAccountHandle": {
          "type": "string",
          "maxLength": 512
        },
        "appTags": {
          "type": "array",
          "items": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "main": {
      "type": "query",
      "description": "Directory listing search and pagination (verified listings with a listing.detail AT URI only). Filters match the at-store /apps page: values within one filter are OR'd, different filters are AND'd.",
      "parameters": {
        "type": "params",
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 512
          },
          "sort": {
            "type": "string",
            "maxLength": 24,
            "default": "popular",
            "enum": [
              "popular",
              "rating",
              "reviews",
              "favorites",
              "newest",
              "updated",
              "alphabetical"
            ],
            "description": "popular = trending score; rating = average rating (unrated last); reviews = review count; favorites = favorite count; newest = created; updated = last updated; alphabetical = name."
          },
          "tag": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "maxLength": 256 },
            "description": "App tags to match (any). Accepts the tag text from appTags or its slug, e.g. 'developer tool' or 'developer'."
          },
          "category": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "maxLength": 512 },
            "description": "Category paths to match (any), including descendants, e.g. 'apps/bluesky' or 'apps/bluesky/client'. 'apps' matches top-level apps only."
          },
          "data": {
            "type": "array",
            "maxLength": 20,
            "items": { "type": "string", "maxLength": 256 },
            "description": "Lexicon producers whose records the listing reads or writes (any), as the first two NSID segments, e.g. 'app.bsky'."
          },
          "minRating": {
            "type": "string",
            "maxLength": 8,
            "knownValues": ["3", "4", "4.5"],
            "description": "Only listings with an average rating at or above this value."
          },
          "has": {
            "type": "array",
            "maxLength": 3,
            "items": {
              "type": "string",
              "maxLength": 32,
              "knownValues": ["open-source", "donations", "official"]
            },
            "description": "Required extras (all): open-source (has a source link), donations (has a donate link), official (has a product account)."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 24
          },
          "cursor": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["listings"],
          "properties": {
            "cursor": {
              "type": "string",
              "maxLength": 512
            },
            "listings": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#listingCardSearch"
              }
            }
          }
        }
      },
      "errors": [{ "name": "InvalidCursor" }]
    }
  }
}
